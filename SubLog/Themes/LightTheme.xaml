<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        라이트 테마 색상 정의
        DynamicResource로 참조하는 모든 컨트롤에 자동 적용됨
        키 이름이 DarkTheme.xaml과 완전히 동일해야 테마 전환이 동작함!
    -->

    <!-- 메인 배경 (ContentControl이 이 색을 씀) -->
    <SolidColorBrush x:Key="AppBackgroundBrush"     Color="#F4F6F9"/>

    <!-- 카드/패널 배경 (Border, StackPanel 배경) -->
    <SolidColorBrush x:Key="CardBackgroundBrush"    Color="#FFFFFF"/>

    <!-- 기본 텍스트 색 -->
    <SolidColorBrush x:Key="PrimaryTextBrush"       Color="#2C3E50"/>

    <!-- 보조 텍스트 색 (설명, 힌트 등) -->
    <SolidColorBrush x:Key="SecondaryTextBrush"     Color="#7F8C8D"/>

    <!-- 구분선, 테두리 색 -->
    <SolidColorBrush x:Key="ThemeBorderBrush"       Color="#E0E0E0"/>

    <!-- 섹션 구분 배경 (설정 항목 카드) -->
    <SolidColorBrush x:Key="SectionBackgroundBrush" Color="#FFFFFF"/>

    <!-- Input 컨트롤 (TextBox, ComboBox 등) -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#2C3E50"/>
    <SolidColorBrush x:Key="InputBorderBrush"     Color="#CCCCCC"/>

    <!-- ─────────────────────────────────────────────
         버튼 Primary (파랑 계열 — 저장, 확인 등 주요 동작)
         ───────────────────────────────────────────── -->
    <SolidColorBrush x:Key="PrimaryButtonBackBrush"      Color="#3498DB"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush"     Color="#2980B9"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush"   Color="#1F618D"/>

    <!-- ─────────────────────────────────────────────
         버튼 Secondary (회색 계열 — 취소, 닫기 등 보조 동작)
         ───────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SecondaryButtonBackBrush"    Color="#BDC3C7"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush"   Color="#95A5A6"/>
    <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="#7F8C8D"/>
    <SolidColorBrush x:Key="SecondaryButtonForeBrush"    Color="#2C3E50"/>

    <!-- ─────────────────────────────────────────────
         버튼 Danger (빨강 계열 — 삭제 등 위험 동작)
         ───────────────────────────────────────────── -->
    <SolidColorBrush x:Key="DangerButtonBackBrush"       Color="#E74C3C"/>
    <SolidColorBrush x:Key="DangerButtonHoverBrush"      Color="#C0392B"/>
    <SolidColorBrush x:Key="DangerButtonPressedBrush"    Color="#922B21"/>

    <!-- ─────────────────────────────────────────────
         DataGrid (목록 화면 테이블)
         ───────────────────────────────────────────── -->
    <SolidColorBrush x:Key="DataGridAltRowBrush"         Color="#F8FAFC"/>
    <SolidColorBrush x:Key="DataGridRowHoverBrush"       Color="#EBF5FB"/>
    <SolidColorBrush x:Key="DataGridRowSelectedBrush"    Color="#D6EAF8"/>
    <SolidColorBrush x:Key="DataGridHeaderBackBrush"     Color="#EDF2F7"/>
    <SolidColorBrush x:Key="DataGridHeaderForeBrush"     Color="#2C3E50"/>

    <!-- ─────────────────────────────────────────────
         사이드바 네비게이션
         ───────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SidebarSelectedBrush"        Color="#3498DB"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"           Color="#2C3E50"/>
</ResourceDictionary>