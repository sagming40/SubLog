<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        라이트 테마 색상 정의
        DynamicResource로 참조하는 모든 컨트롤에 자동 적용됨
        키 이름이 DarkTheme.xaml과 완전히 동일해야 테마 전환이 동작함!
    -->

    <!-- 메인 배경 (ContentControl이 이 색을 씀) -->
    <SolidColorBrush x:Key="AppBackgroundBrush"     Color="#F4F6F9"/>

    <!-- 카드/패널 배경 (Border, StackPanel 배경) -->
    <SolidColorBrush x:Key="CardBackgroundBrush"    Color="#FFFFFF"/>

    <!-- 기본 텍스트 색 -->
    <SolidColorBrush x:Key="PrimaryTextBrush"       Color="#2C3E50"/>

    <!-- 보조 텍스트 색 (설명, 힌트 등) -->
    <SolidColorBrush x:Key="SecondaryTextBrush"     Color="#7F8C8D"/>

    <!-- 구분선, 테두리 색 -->
    <SolidColorBrush x:Key="ThemeBorderBrush"       Color="#E0E0E0"/>

    <!-- 섹션 구분 배경 (설정 항목 카드) -->
    <SolidColorBrush x:Key="SectionBackgroundBrush" Color="#FFFFFF"/>
    
</ResourceDictionary>