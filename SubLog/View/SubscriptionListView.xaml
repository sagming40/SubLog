<UserControl x:Class="SubLog.View.SubscriptionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SubLog.Converters">
    
    <!--
    ╔══════════════════════════════════════════════╗
    ║  converter 등록                               ║
    ║  x:Key = XAML에서 이 이름으로 참조              ║
    ╚══════════════════════════════════════════════╝
    -->
    <UserControl.Resources>
        <converters:BillingCycleConverter x:Key="BillingCycleConverter"/>
        <converters:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
    </UserControl.Resources>

    <!--
    전체 레이아웃: 4행 구성
    Auto: 내용만큼만 차지 / *: 나머지 전부
    -->
    <Grid Background="#F4F6F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: 헤더 -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: 필터 / 버튼 -->
            <RowDefinition Height="*"/>     <!-- Row 2: DataGrid -->
            <RowDefinition Height="Auto"/>  <!-- Row 3: 하단 상태바 -->
        </Grid.RowDefinitions>

        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
             Row 0: 헤더 (제목 + 추가 버튼)
             DockPanel: 마지막 자식이 나머지 공간 차지
             ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <Border Grid.Row="0" Padding="28,24,28,16">
            <DockPanel>
                <!-- DockPanel.Dock="Right": 오른쪽에 고정 배치 -->
                <Button DockPanel.Dock="Right"
                        Content="+ 구독 추가" Command="{Binding AddCommand}" 
                        FontSize="13" FontWeight="Bold" Padding="18,9" Cursor="Hand"/>
                
                <!-- DockPanel의 마지막 자식 → 나머지 왼쪽 공간 차지 -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="구독 목록" Foreground="#2C3E50"
                               FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="등록된 구독 서비스를 확인하고 관리하세요"
                               Margin="0,4,0,0" FontSize="13" Foreground="#7F8C8D"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
             Row 1: 필터 영역 + 편집 버튼들
             WrapPanel: 자식들을 가로로 나열, 넘치면 다음 줄로
             ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <Border Grid.Row="1" Padding="28,10" Background="White"
                BorderBrush="#E8ECF0" BorderThickness="0,1,0,1">
            <WrapPanel VerticalAlignment="Center">
                
                <!-- 검색 영역 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <!--
                        UpdateSourceTrigger=PropertyChanged:
                        글자를 입력할 때마다 즉시 SearchText 속성에 반영
                        (기본값인 LostFocus는 포커스를 잃을 때만 반영됨)
                    -->
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" FontSize="13"
                             Width="200" Height="30" Padding="8,0"/>
                </StackPanel>
                
                <!-- 활성만 보기 체크박스 -->
                <CheckBox Content="활성만 보기" FontSize="13"
                          IsChecked="{Binding ShowActiveOnly}"
                          VerticalAlignment="Center" Margin="0,0,24,0"/>
                
                <!-- 구분선 -->
                <Border Width="1" Height="20" Background="#DDE1E5"
                        VerticalAlignment="Center" Margin="0,0,16,0"/>
                
                <!-- 수정 버튼 (행 선택 시에만 활성화) -->
                <Button Content="✏️ 수정" Margin="0,0,8,0" Padding="14,6"
                        Command="{Binding EditCommand}" FontSize="13" Cursor="Hand"/>

                <!-- 삭제 버튼 (행 선택 시에만 활성화) -->
                <Button Content="🗑️ 삭제" Margin="0,0,16,0" Padding="14,6"
                        Command="{Binding DeleteCommand}" FontSize="13" Cursor="Hand"/>

                <!-- 구분선 -->
                <Border Width="1" Height="20" Background="#DDE1E5"
                        VerticalAlignment="Center" Margin="0,0,16,0"/>
                <!-- 새로고침 버튼 -->
                <Button Content="🔄 새로고침" Padding="14,6" Cursor="Hand"
                        Command="{Binding RefreshCommand}" FontSize="13"/>
            </WrapPanel>
        </Border>

        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
             Row 2: DataGrid — 구독 목록 표
             ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Subscriptions}"
                  SelectedItem="{Binding SelectedSubscription}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="True" CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal" RowBackground="White"
                  AlternatingRowBackground="#F8FAFC" SelectionMode="Single"
                  HeadersVisibility="Column" ColumnHeaderHeight="38"
                  RowHeight="42" Margin="16,8,16,0" FontSize="13"
                  Background="White" BorderBrush="#E8ECF0">
            
            <!-- 컬럼 헤더 스타일 -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"   Value="White"/>
                    <Setter Property="Foreground"   Value="#7F8C8D"/>
                    <Setter Property="FontWeight"   Value="SemiBold"/>
                    <Setter Property="FontSize"     Value="12"/>
                    <Setter Property="Padding"      Value="12,0"/>
                    <Setter Property="BorderBrush"  Value="#E8ECF0"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            
            <!-- 셀 스타일 (선택된 행 색상 포함) -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding"               Value="12,0"/>
                    <Setter Property="BorderThickness"       Value="0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Style.Triggers>
                        <!-- 선택된 셀: 연파랑 배경 + 기본 글자색 유지 -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#EBF5FB"/>
                            <Setter Property="Foreground" Value="#2C3E50"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <!-- ─── 컬럼 정의 ─── -->
            <DataGrid.Columns>
                
                <!-- 서비스명: Width="*" → 나머지 공간 전부 차지 -->
                <DataGridTextColumn Header="서비스명" Binding="{Binding Name}" Width="*"/>
                
                <!-- 금액: StringFormat={}{0:N0} → "29,000원" 형식 -->
                <DataGridTextColumn Header="금액" Width="120"
                                    Binding="{Binding Price, StringFormat={}{0:N0}원}"/>
                
                <!-- 결제일: StringFormat{}{0}일 → "15일" 형식 -->
                <DataGridTextColumn Header="결제일" Width="80"
                                    Binding="{Binding BillingDay, StringFormat={}{0}일}"/>
                
                <!-- 결제 주기: Converter로 Monthly → "월정액" 변환 -->
                <DataGridTextColumn Header="결제 주기" Width="90"
                                    Binding="{Binding BillingCycle,
                                              Converter={StaticResource BillingCycleConverter}}"/>
                
                <!-- 카테고리: 네비게이션 속성 (EF Core가 Include로 함께 로드) -->
                <DataGridTextColumn Header="카테고리" Width="110" Binding="{Binding Category.Name}"/>

                <!-- 상태: Converter로 true → "✅ 활성" 변환 -->
                <DataGridTextColumn Header="상태" Width="90"
                                    Binding="{Binding IsActive,
                                              Converter={StaticResource BoolToStatusConverter}}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
             Row 3: 하단 상태바 (검색 결과 수)
             ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <Border Grid.Row="3" Padding="28,8" Background="White"
                BorderBrush="#E8ECF0" BorderThickness="0,1,0,0">
            <TextBlock FontSize="12" Foreground="#7F8C8D">
                <Run Text="검색 결과:"/>
                <Run Text="{Binding Subscriptions.Count, Mode=OneWay}"
                     FontWeight="Bold" Foreground="#2C3E50"/>
                <Run Text="개"/>
            </TextBlock>
        </Border>
        
    </Grid>
</UserControl>
