<UserControl x:Class="SubLog.View.SubscriptionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SubLog.Converters"
             PreviewMouseLeftButtonDown="UserControl_PreviewMouseLeftButtonDown">
    
    <!--
    ╔══════════════════════════════════════════════╗
    ║  converter 등록                               ║
    ║  x:Key = XAML에서 이 이름으로 참조              ║
    ╚══════════════════════════════════════════════╝
    -->
    <UserControl.Resources>
        <converters:BillingCycleConverter x:Key="BillingCycleConverter"/>
        <converters:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <converters:DaysToBadgeConverter  x:Key="DaysToBadgeConverter"/>
        <converters:DaysToColorConverter  x:Key="DaysToColorConverter"/>
        <!-- ✅ 추가 ㅡ 구독 목록 컬럼 헤더 정중앙 정렬
            <Style x:Key="CenteredHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style> 
        -->
    </UserControl.Resources>

    <!--
    전체 레이아웃: 4행 구성
    Auto: 내용만큼만 차지 / *: 나머지 전부
    -->
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: 헤더 -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: 필터 / 버튼 -->
            <RowDefinition Height="*"/>     <!-- Row 2: DataGrid -->
            <RowDefinition Height="Auto"/>  <!-- Row 3: 하단 상태바 -->
        </Grid.RowDefinitions>

        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
             Row 0: 헤더 (제목 + 추가 버튼)
             DockPanel: 마지막 자식이 나머지 공간 차지
             ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <Border Grid.Row="0" Padding="28,24,28,16">
            <DockPanel>
                <!-- DockPanel.Dock="Right": 오른쪽에 고정 배치 -->
                <!-- ❌ 기존 (버튼 하나) 
                <Button DockPanel.Dock="Right"
                        Content="+ 구독 추가" Command="{Binding AddCommand}" 
                        FontSize="13" FontWeight="Bold" Padding="18,9" Cursor="Hand"/> 
                -->

                <!-- ✅ 교체 (버튼 두 개를 StackPanel으로 묶기) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">

                    <!-- Catalog Button -->
                    <Button Content="📚 카탈로그" Command="{Binding OpenCatalogCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>

                    <!-- Add Subscription Button -->
                    <Button Content="+ 구독 추가" Command="{Binding AddCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                    
                </StackPanel>
                
                <!-- DockPanel의 마지막 자식 → 나머지 왼쪽 공간 차지 -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="구독 목록" Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="등록된 구독 서비스를 확인하고 관리하세요" Margin="0,4,0,0" 
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
             Row 1: 필터 영역 + 편집 버튼들
             WrapPanel: 자식들을 가로로 나열, 넘치면 다음 줄로
             ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <Border Grid.Row="1" Padding="28,10" BorderThickness="0,1,0,1"
                BorderBrush="{DynamicResource ThemeBorderBrush}" 
                Background="{DynamicResource CardBackgroundBrush}">
            <WrapPanel VerticalAlignment="Center">
                
                <!-- 검색 영역 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <!--
                        UpdateSourceTrigger=PropertyChanged:
                        글자를 입력할 때마다 즉시 SearchText 속성에 반영
                        (기본값인 LostFocus는 포커스를 잃을 때만 반영됨)
                    -->
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" FontSize="13"
                             Width="200" Height="30" Padding="8,0"/>
                </StackPanel>
                
                <!-- 활성만 보기 체크박스 -->
                <CheckBox Content="활성만 보기" FontSize="13"
                          IsChecked="{Binding ShowActiveOnly}"
                          VerticalAlignment="Center" Margin="0,0,24,0"/>
                
                <!-- 구분선 -->
                <Border Width="1" Height="20" Background="#DDE1E5"
                        VerticalAlignment="Center" Margin="0,0,16,0"/>
                
                <!-- 수정 버튼 (행 선택 시에만 활성화) -->
                <Button Content="✏️ 수정" Command="{Binding EditCommand}"
                        Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"/>

                <!-- 삭제 버튼 (행 선택 시에만 활성화) -->
                <Button Content="🗑️ 삭제" Command="{Binding DeleteCommand}"
                        Margin="0,0,16,0" Style="{StaticResource DangerButton}"/>

                <!-- 구분선 -->
                <Border Width="1" Height="20" Background="#DDE1E5"
                        VerticalAlignment="Center" Margin="0,0,16,0"/>
                <!-- 새로고침 버튼 -->
                <Button Content="🔄 새로고침" Command="{Binding RefreshCommand}" 
                        Style="{StaticResource SecondaryButton}"/>
            </WrapPanel>
        </Border>

        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
             Row 2: DataGrid — 구독 목록 표
             ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        
        <!-- ✅ Task 4-1 컬럼 헤더/셀 스타일 하드코딩 -->
        <DataGrid x:Name="SubscriptionDataGrid"
                  Grid.Row="2" ItemsSource="{Binding Subscriptions}" Margin="16,8,16,0"
                  SelectedItem="{Binding SelectedSubscription}" IsReadOnly="True"
                  CanUserSortColumns="True" CanUserResizeColumns="True"
                  Style="{StaticResource SubLogDataGrid}" ColumnHeaderHeight="38"
                  RowStyle="{StaticResource SubLogDataGridRow}"
                  CellStyle="{StaticResource SubLogDataGridCell}"
                  ColumnHeaderStyle="{StaticResource SubLogDataGridHeader}">

            <!-- ─── 컬럼 정의 ─── -->
            <DataGrid.Columns>
                
                <!-- 서비스명: Width="*" → 나머지 공간 전부 차지 -->
                <DataGridTextColumn Header="서비스명" Binding="{Binding Name}" Width="*"/>
                <!-- ✅ 추가
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle> 
                -->

                <!-- 금액: StringFormat={}{0:N0} → "29,000원" 형식 -->
                <DataGridTemplateColumn Header="금액" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <!-- KRW 기본값 -->
                                        <Setter Property="Text"
                                                Value="{Binding Price, StringFormat={}{0:N0}원}"/>
                                        <Style.Triggers>
                                            <!-- USD이면 달러 표시 -->
                                            <DataTrigger Binding="{Binding CurrencyCode}" Value="USD">
                                                <Setter Property="Text">
                                                    <Setter.Value>
                                                        <Binding Path="Price" StringFormat="$#,##0.##"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- 결제일: StringFormat{}{0}일 → "15일" 형식 -->
                <DataGridTextColumn Header="결제일" Width="80" Binding="{Binding BillingDay, StringFormat={}{0}일}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <!-- 결제 주기: Converter로 Monthly → "월정액" 변환 -->
                <DataGridTextColumn Header="결제 주기" Width="90"
                                    Binding="{Binding BillingCycle,
                                              Converter={StaticResource BillingCycleConverter}}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <!-- 카테고리: 네비게이션 속성 (EF Core가 Include로 함께 로드) -->
                <DataGridTextColumn Header="카테고리" Width="110" Binding="{Binding Category.Name}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 상태: Converter로 true → "✅ 활성" 변환 -->
                <DataGridTextColumn Header="상태" Width="90"
                                    Binding="{Binding IsActive,
                                              Converter={StaticResource BoolToStatusConverter}}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- ✅ Task 3-5 추가 ㅡ 통화/원화 환산 금액 열 -->
                <!-- 통화 열 -->
                <DataGridTextColumn Header="통화" Width="60" Binding="{Binding CurrencyCode}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 원화 환산 금액 열 -->
                <DataGridTextColumn Header="원화 금액" Width="120"
                                    Binding="{Binding KrwEquivalent, StringFormat={}{0:N0}원}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                
                <!-- ✅ D-Day 배지 컬럼 추가 -->
                <!--
                    DataGridTemplateColumn: 셀 안에 자유롭게 XAML 구성 가능한 컬럼
                    일반 텍스트 컬럼으로는 색상 배지 표현이 불가능하기 때문에 사용

                    {Binding}: DataContext 자체(Subscription 객체 전체)를 컨버터에 전달
                    → DaysToBadgeConverter / DaysToColorConverter 가 받아서 처리
                -->
                <DataGridTemplateColumn Header="결제 D-DAY" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Center" Padding="8,3"
                                    VerticalAlignment="Center" CornerRadius="4"
                                    Background="{Binding Converter={StaticResource DaysToColorConverter}}">
                                <TextBlock Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                           Text="{Binding Converter={StaticResource DaysToBadgeConverter}, Mode=OneWay}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
             Row 3: 하단 상태바 (검색 결과 수)
             ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->

        <!-- ✅ Task 4-1 수정 ㅡ 하단 상태바 하드코딩 → DynamicResource -->
        <Border Grid.Row="3" Padding="28,8" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                Background="{DynamicResource CardBackgroundBrush}">
            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}">
                <Run Text="검색 결과:"/>
                <Run Text="{Binding Subscriptions.Count, Mode=OneWay}"
                     FontWeight="Bold" Foreground="#2C3E50"/>
                <Run Text="개"/>
            </TextBlock>
        </Border>
        
    </Grid>
</UserControl>
