<UserControl x:Class="SubLog.View.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:converters="clr-namespace:SubLog.Converters">

    <UserControl.Resources>
        <converters:DaysToBadgeConverter x:Key="DaysToBadgeConverter"/>
        <converters:DaysToColorConverter x:Key="DaysToColorConverter"/>
    </UserControl.Resources>

     <!--
        ScrollViewer: 창 크기가 작아져도 스크롤로 전체 내용 접근 가능
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">

            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                 헤더 (제목 + 부제목 + 오늘 환율)
                 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>    <!-- 왼쪽: 제목/부제목 -->
                    <ColumnDefinition Width="Auto"/> <!-- 오른쪽: 환율 정보 -->
                </Grid.ColumnDefinitions>

                <!-- 왼쪽: 제목 + 부제목 -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="대시보드" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="#7F8C8D"
                               Text="구독 현황을 한 눈에 확인해보세요"/>
                </StackPanel>

                <!-- ✅ 추가: 오른쪽 — 오늘 적용된 USD→KRW 환율 -->
                <Border Grid.Column="1" Background="#F8F9FA" 
                        VerticalAlignment="Top" CornerRadius="8" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💱" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#7F8C8D">
                            <Run Text="오늘 환율 $1 = ₩" FontSize="14"/>
                            <Run Text="{Binding TodayExchangeRate, StringFormat={}{0:N2}}"
                                 FontWeight="SemiBold" Foreground="#2C3E50" FontSize="14"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                 요약 카드 3개
                 UniformGrid Columns="3":
                 자식 3개를 같은 너비로 자동 분할
                 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <UniformGrid Columns="3" Margin="0,0,0,24">

                <!-- ▶ 카드 1: 월 지출 합계 -->
                <Border Margin="0,0,10,0" Padding="20,18" Background="White" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect Color="#AAAAAA" BlurRadius="12"
                                          ShadowDepth="2" Opacity="0.12"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="💰 이번 달 지출" FontSize="12" Foreground="#7F8C8D"/>
                        <!-- 숫자 + 단위 "원"을 나란히 배치 -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <!-- StringFormat={}{0:N0} → 천 단위 쉼표 포맷
                                 예: 29900 → 29,900 -->
                            <TextBlock Text="{Binding TotalMonthlySpend, StringFormat={}{0:N0}}"
                                       FontSize="28" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text=" 원" VerticalAlignment="Bottom" Margin="2,0,0,3"
                                       FontSize="16" Foreground="#2C3E50"/>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="#BDC3C7" 
                                   Text="활성 월 정액 구독 합산" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ▶ 카드 2: 활성 구독 수 -->
                <Border Margin="5,0" Padding="20,18" Background="White" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect Color="#AAAAAA" BlurRadius="12" ShadowDepth="2" Opacity="0.12"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="📋 활성 구독 수" FontSize="12" Foreground="#7F8C8D"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding ActiveSubscriptionCount}"
                                       FontSize="28" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text=" 개" VerticalAlignment="Bottom"
                                       FontSize="16" Margin="2,0,0,3" Foreground="#2C3E50"/>
                        </StackPanel>
                        <TextBlock Text="현재 구독 중인 서비스" Margin="0,6,0,0"
                                   Foreground="#BDC3C7" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- ▶ 카드 3: 결제 예정 (빨간색으로 주의 강조) -->
                <Border Margin="10,0,0,0" Padding="20,18" CornerRadius="12" Background="White">
                    <Border.Effect>
                        <DropShadowEffect Color="#AAAAAA" BlurRadius="12" ShadowDepth="2" Opacity="0.12"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="⏰ 결제 예정 (7일 이내)" FontSize="12" Foreground="#7F8C8D"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding UpcomingBillingCount}"
                                       FontSize="28" FontWeight="Bold" Foreground="#E74C3C"/>
                            <TextBlock Text=" 건" VerticalAlignment="Bottom"
                                       Margin="2,0,0,3" FontSize="16" Foreground="#E74C3C"/>
                        </StackPanel>
                        <TextBlock Text="주의가 필요한 구독" FontSize="11"
                                   Foreground="#BDC3C7" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                
            </UniformGrid>

            <!-- ✅ 결제 예정 목록 섹션 (카드와 도넛 차트 사이) -->
            <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                <Border.Effect>
                    <DropShadowEffect Color="#AAAAAA" BlurRadius="12" ShadowDepth="2" Opacity="0.12"/>
                </Border.Effect>
                <StackPanel>
                    <!-- 섹션 헤더 -->
                    <TextBlock Text="⏰ 7일 내 결제 예정" Margin="0,0,0,16" FontSize="15"
                               Foreground="#2C3E50" FontWeight="Bold"/>

                    <!--
                        UpcomingSubscriptions가 비어 있을 때 표시할 메시지
                        Visibility: Count == 0이면 Visible, 아니면 Collapsed
                    -->
                    <TextBlock Text="✅ 7일 내 결제 예정 구독이 없습니다." Foreground="#7F8C8D"
                               HorizontalAlignment="Center" FontSize="13" Padding="0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpcomingSubscriptions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--
                        결제 예정 구독 목록
                        ItemsControl: DataGrid처럼 데이터 목록을 표시하지만
                        선택, 정렬 등 부가 기능 없이 순수하게 목록만 표시할 때 사용
                    -->
                    <ItemsControl ItemsSource="{Binding UpcomingSubscriptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12,10" Background="#F8F9FA" CornerRadius="8">
                                    <DockPanel>

                                        <!-- D-Day 배지 (오른쪽 고정) -->
                                        <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                                                Background="{Binding Converter={StaticResource DaysToColorConverter}}"
                                                Padding="10,4" CornerRadius="4">
                                            <TextBlock Foreground="White" FontSize="12" FontWeight="Bold"
                                                       Text="{Binding Converter={StaticResource DaysToBadgeConverter}, Mode=OneWay}"/>
                                        </Border>

                                        <!-- 구독 이름 + 결제일 -->
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                            <TextBlock FontSize="12" Foreground="#7F8C8D" Margin="0,2,0,0">
                                                <Run Text="매월"/>
                                                <Run Text="{Binding BillingDay, Mode=OneWay}"/>
                                                <Run Text="일 결제 ·"/>
                                                <Run Text="{Binding Price, StringFormat={}{0:N0}, Mode=OneWay}"
                                                     FontWeight="SemiBold" Foreground="#2C3E50"/>
                                            </TextBlock>
                                        </StackPanel>
                                        
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                 도넛 차트 섹션
                 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <Border Background="White" CornerRadius="12" Padding="24">
                <Border.Effect>
                    <DropShadowEffect Color="#AAAAAA" BlurRadius="12" ShadowDepth="2" Opacity="0.12"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="카테고리별 지출 비율" Foreground="#2C3E50"
                               Margin="0,0,0,16" FontSize="15" FontWeight="Bold"/>

                    <!--
                        lvc:PieChart — LiveCharts2 파이/도넛 차트
                        Series       : ViewModel의 DonutSeries 바인딩
                        InitialRotation="-90" : 12시 방향에서 시작 (기본은 3시)
                        IsClockwise  : 시계 방향으로 그리기
                        LegendPosition="Right" : 오른쪽에 범례 표시
                    -->
                    <lvc:PieChart Series="{Binding DonutSeries}" Height="280"
                                  InitialRotation="-90" LegendPosition="Right" IsClockwise="True"/>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
