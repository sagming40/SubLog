<Window x:Class="SubLog.View.MainWindow"
        xmlns:vm="clr-namespace:SubLog.ViewModel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:view="clr-namespace:SubLog.View"
        mc:Ignorable="d" 
        Title="SubLog - 구독관리" Height="720" Width="1080"
        MinHeight="600" MinWidth="900" 
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <!--
    ╔══════════════════════════════════════════════════════╗
    ║  Window.Resources — ViewModel → View 자동 매핑 규칙    ║
    ║  "이 ViewModel 타입이 오면 저 View를 보여줘"             ║
    ╚══════════════════════════════════════════════════════╝
    -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <view:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SubscriptionListViewModel}">
            <view:SubscriptionListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <view:SettingsView />
        </DataTemplate>
        <!-- ✅ 아래 줄 추가 -->
        <DataTemplate DataType="{x:Type vm:CategoryManagementViewModel}">
            <view:CategoryManagementView/>
        </DataTemplate>
        <!-- ✅ Task 3-4 추가 ㅡ 도넛/막대 차트 ViewModel -->
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <view:StatisticsView/>
        </DataTemplate>
    </Window.Resources>

    <!--
    ╔══════════════════════════════════════════════════╗
    ║  최상위 Grid: 사이드바(200px) | 콘텐츠(나머지) 분할   ║
    ╚══════════════════════════════════════════════════╝
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
             왼쪽 사이드바 (Grid.Column="0")
             ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <Border Grid.Column="0" Background="#1E2A3A">
            <DockPanel>

                <!-- ▶ 앱 로고 / 이름 영역 -->
                <Border DockPanel.Dock="Top" Padding="20,24,20,16"
                        BorderBrush="#2C3E50" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="SubLog" FontSize="22"
                                   FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="구독 관리 앱" FontSize="11"
                                   Foreground="#7F8C8D" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ▶ 네비게이션 버튼 목록 -->
                <StackPanel DockPanel.Dock="Top" Margin="12,16,12,0">
                    
                    <!-- IsChecked="True" → 앱 시작 시 대시보드가 기본 선택 -->
                    <RadioButton Content="📊 대시보드" IsChecked="True" Margin="0,2"
                                 Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateDashboardCommand}"/>

                    <RadioButton Content="📋 구독 목록" Margin="0,2"
                                 Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateSubscriptionCommand}"/>
                    
                    <!-- ✅ 아래 버튼 추가 -->
                    <RadioButton Content="🏷 카테고리" Margin="0,2"
                                 Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateCategoryManagementCommand}"/>

                    <!-- ✅ Task 3-4 추가 ㅡ 📈 통계 분석 사이드바 버튼 -->
                    <RadioButton Content="📈 통계 분석" Margin="0,2"
                                 Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateStatisticsCommand}"/>

                    <RadioButton Content="⚙️ 설정" Margin="0,2"
                                 Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateSettingsCommand}"/>
                    
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
             오른쪽 콘텐츠 영역 (Grid.Column="1")
             CurrentView가 바뀌면 DataTemplate 규칙에 따라
             자동으로 맞는 View가 여기 표시됩니다
             ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->

        <!-- ✅ <수정> "Task 3-2" (DynamicResource — 테마 파일 교체 시 자동 반응) -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" 
                        Background="{DynamicResource AppBackgroundBrush}"/>
    </Grid>
</Window>
