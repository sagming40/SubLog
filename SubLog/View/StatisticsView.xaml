<UserControl x:Class="SubLog.View.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                 페이지 제목
                 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                       Text="📈 통계 분석" Margin="0,0,0,20" FontSize="22" FontWeight="Bold"/>

            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                 요약 카드 3개
                 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <UniformGrid Columns="3" Margin="0,0,0,20">
                
                <!-- 카드 1: 이번 달 총 지출 -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="12" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="이번 달 총 지출" FontSize="12" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Foreground="{DynamicResource AccentBrush}" FontSize="16"
                                       VerticalAlignment="Bottom" Margin="0,0,2,3" Text="₩"/>
                            <TextBlock Text="{Binding TotalMonthly, StringFormat={}{0:N0}}" FontSize="26"
                                       Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="월정액 기준" Margin="0,6,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                
                <!-- 카드 2: 활성 구독 수 -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="12" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="활성 구독 수" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding ActiveCount}" FontWeight="Bold" FontSize="26"/>
                            <TextBlock Text="개" Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Bottom" Margin="2,0,0,3" FontSize="16"/>
                        </StackPanel>
                        <TextBlock Text="현재 구독 중인 서비스" Margin="0,6,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                
                <!-- 카드 3: 최고 지출 카테고리 -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="최고 지출 카테고리" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TopCategory}" Margin="0,8,0,0" FontWeight="Bold"
                                   FontSize="22" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="월 지출 1등" Margin="0,6,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                 막대 차트 섹션 (월별 지출)
                 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Margin="0,0,0,20" Padding="24">
                <StackPanel>
                    <TextBlock Text="월별 지출 추이 (최근 6개월)" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <!--
                        CartesianChart — LiveCharts2 막대/선 차트 컨트롤
                        Series  : ViewModel의 BarSeries 바인딩 (막대 데이터)
                        XAxes   : X축 설정 (월 이름 레이블)
                        YAxes   : Y축 설정 (₩ 포맷)
                        ⚠️ XAxes/YAxes는 배열이라 Mode=OneWay 명시!
                    -->
                    <lvc:CartesianChart Series="{Binding BarSeries}" LegendPosition="Hidden" Height="320"
                                        XAxes="{Binding XAxes, Mode=OneWay}" YAxes="{Binding YAxes, Mode=OneWay}"/>
                </StackPanel>
            </Border>

            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                 도넛 차트 섹션 (카테고리별 비율)
                 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="카테고리별 지출 비율" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <!--
                        PieChart — 파이/도넛 차트
                        InitialRotation="-90" : 12시 방향부터 시작
                        LegendPosition="Right" : 오른쪽에 범례
                    -->
                    <lvc:PieChart Series="{Binding DonutSeries}" Height="400"
                                  InitialRotation="-90" LegendPosition="Right" IsClockwise="True"/>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
