<UserControl x:Class="SubLog.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900">

    <!--
        ⚠️ 이 화면의 색상은 모두 DynamicResource를 사용합니다.
        DynamicResource = 테마가 바뀌면 즉시 반응 (vs StaticResource는 반응 안 함)
        LightTheme.xaml / DarkTheme.xaml 에 정의된 키와 이름이 일치해야 작동합니다.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel Margin="40" MaxWidth="620">
            <!-- ── 헤더 ── -->
            <TextBlock Text="⚙️ 설정" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="앱의 외관과 기본 설정을 변경합니다." FontSize="13" Margin="0,4,0,32"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

            <!-- ══════════════════════════════
                 테마 섹션
                 ══════════════════════════════ -->
            <TextBlock Text="🎨 테마" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>

            <Border Background="{DynamicResource SectionBackgroundBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" Margin="0,0,0,24"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" 
                                   Text="다크 모드" FontSize="14"/>
                        <TextBlock Text="화면을 다크 모드로 변경합니다." Margin="0,3,0,0"
                                   Foreground="{DynamicResource SeconddaryTextBrush}" FontSize="12"/>
                    </StackPanel>

                    <!--
                        CheckBox.IsChecked → IsDarkTheme 양방향 바인딩
                        체크 즉시 OnIsDarkThemeChanged 호출 → ApplyTheme() 실행
                    -->
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsDarkTheme}"
                              VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0"/>
                </DockPanel>
            </Border>

            <!-- ══════════════════════════════
                 기본 통화 섹션
                 ══════════════════════════════ -->
            <TextBlock Text="💰 기본 통화" Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <Border Background="{DynamicResource SectionBackgroundBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,24" Padding="20,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="기본 통화 단위" FontSize="14" 
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="새 구독 추가 시 기본으로 선택되는 통화입니다. (Task 3-5 환율 기능에서 사용)"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>

                    <ComboBox DockPanel.Dock="Right" Width="120" Margin="16,0,0,0"
                              ItemsSource="{Binding CurrencyOptions}"
                              SelectedItem="{Binding SelectedCurrency}"
                              HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!--
                            ItemTemplate: 각 항목을 어떻게 표시할지 직접 지정
                            기본 스타일에서 텍스트 색이 배경과 같아 안 보이는 문제 해결
                        -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#2C3E50" Padding="4,2"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
            </Border>

            <!-- ══════════════════════════════
                 앱 정보 섹션
                 ══════════════════════════════ -->
            <TextBlock Text="ℹ️ 앱 정보" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <Border Padding="20,16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource SectionBackgroundBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}">
                        <Run Text="SubLog "/>
                        <!--
                        ✅ 수정
                        AppVersion은 { get; } 만 있는 읽기 전용 속성임
                        Run의 기본 바인딩 모드가 TwoWay라 쓰기를 시도함 
                        따라서, 설정창이 정상 작동하지 않는 상황이 발생 Mode=OneWay를 추가하여 수정 
                        -->
                        <Run Text="{Binding AppVersion, Mode=OneWay}" Foreground="#3498DB"/>
                    </TextBlock>
                    <TextBlock Text="개인 구독 서비스 통합 관리 앱" Margin="0,4,0,0" FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="포트폴리오 프로젝트 / 사공민규" Margin="0,2,0,0" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <Separator Margin="0,12" Background="{DynamicResource ThemeBorderBrush}"/>

                    <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}">
                        <Run Text="기술 스택: "/>
                        <Run Text="C# · WPF (.NET 8) · MVVM · EF Core · SQLite · LiveCharts2"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
