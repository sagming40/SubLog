<UserControl x:Class="SubLog.View.CategoryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:SubLog.Converters"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900"
             PreviewMouseLeftButtonDown="UserControl_PreviewMouseLeftButtonDown">

    <!--
        UserControl.Resources: 이 화면 안에서만 쓸 컨버터를 등록
        StaticResource로 이름을 붙여놓으면 아래 어디서나 {StaticResource HexToBrushConverter}로 사용 가능
    -->
    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 헤더 영역 -->
            <RowDefinition Height="*"/>    <!-- 본문 영역 (나머지 전부) -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════
             헤더: 페이지 제목 + 설명
             ══════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            
            <TextBlock Text="🏷 카테고리 관리" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <TextBlock Text="구독 서비스를 분류할 카테고리를 추가하고 관리합니다." FontSize="13" 
                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>

        </StackPanel>

        <!-- ══════════════════════════════════
             본문: 좌우 2열 레이아웃
             좌: 카테고리 목록 DataGrid
             우: 추가/수정 폼
             ══════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>   <!-- 좌측: 목록 (나머지) -->
                <ColumnDefinition Width="16"/>  <!-- 중간: 여백 -->
                <ColumnDefinition Width="280"/> <!-- 우측: 폼 (고정 너비) -->
            </Grid.ColumnDefinitions>

            <!-- ── 좌측: 카테고리 목록 DataGrid ── -->
            <DataGrid x:Name="CategoryDataGrid" Grid.Column="0" 
                      SelectedItem="{Binding SelectedCategory}"
                      IsReadOnly="True" ItemsSource="{Binding Categories}"
                      CanUserReorderColumns="False"
                      Style="{StaticResource SubLogDataGrid}"
                      RowStyle="{StaticResource SubLogDataGridRow}"
                      CellStyle="{StaticResource SubLogDataGridCell}"
                      ColumnHeaderStyle="{StaticResource SubLogDataGridHeader}">

                <DataGrid.Columns>

                    <!-- 색상 미리보기: 색상 코드를 직사각형 컬러 블록으로 표시 -->
                    <!-- DataGridTemplateColumn: 자유롭게 XAML로 셀 내용을 구성할 수 있는 컬럼 -->
                    <DataGridTemplateColumn Header="색상" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!--
                                    Background 바인딩에 HexToBrushConverter 적용
                                    DataGrid 셀 안의 DataContext는 각 Category 객체
                                    → Category.ColorHex → HexToBrushConverter → SolidColorBrush
                                -->
                                <Border Width="36" Height="20" CornerRadius="4"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{Binding ColorHex,
                                            Converter={StaticResource HexToBrushConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 카테고리 이름 -->

                    <DataGridTextColumn Header="카테고리 이름" Binding="{Binding Name}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="FontSize"            Value="13"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- HEX 코드 (Consolas 폰트로 코드처럼 표시) -->
                    <DataGridTextColumn Header="HEX 코드" Binding="{Binding ColorHex}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="FontFamily"          Value="Consolas"/>
                                <Setter Property="Foreground"          
                                        Value="{DynamicResource SecondaryTextBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                </DataGrid.Columns>
            </DataGrid>

            <!-- ── 우측: 추가/수정 폼 ── -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource ThemeBorderBrush}" 
                    Background="{DynamicResource SectionBackgroundBrush}" Padding="20"
                    VerticalAlignment="Top" BorderThickness="1" CornerRadius="8">
                <StackPanel>

                    <!-- 폼 제목 -->
                    <TextBlock Text="카테고리 추가 / 수정" FontWeight="SemiBold" Margin="0,0,0,20"
                               FontSize="15" Foreground="{DynamicResource PrimaryTextBursh}"/>
                    
                    <!-- 이름 입력 -->
                    <TextBlock Text="카테고리 이름" FontSize="12" Margin="0,0,0,4"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             BorderBrush="#DDDDDD" BorderThickness="1"
                             Margin="0,0,0,16" Padding="10,8" FontSize="13"/>

                    <!-- HEX 코드 입력 -->
                    <TextBlock Text="색상 코드 (예: #3498DB)" Margin="0,0,0,4"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                    <TextBox Text="{Binding EditColorHex, UpdateSourceTrigger=PropertyChanged}"
                             BorderBrush="#DDDDDD" BorderThickness="1"
                             Margin="0,0,0,8" Padding="10,8" FontSize="13" FontFamily="Consolas"/>

                    <!--
                        색상 미리보기 영역
                        EditColorHex가 바뀌는 즉시 (PropertyChanged) Background가 갱신됨
                        사용자가 HEX 코드를 타이핑하면 실시간으로 색상이 변함
                    -->
                    <Border Height="36" CornerRadius="6" Margin="0,0,0,16"
                            Background="{Binding EditColorHex,
                                Converter={StaticResource HexToBrushConverter}}"/>

                    <!-- 색상 팔레트 -->
                    <TextBlock Text="자주 쓰는 색상" FontSize="11" Margin="0,0,0,8"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <!--
                        ItemsControl: PresetColors (List<string>)를 순회하며 버튼 생성
                        WrapPanel: 버튼이 공간 부족하면 자동으로 다음 줄로 넘어감
                    -->
                    <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    ⚠️ 중요: DataTemplate 안의 DataContext는 각 색상 문자열
                                    SelectPresetColorCommand는 ViewModel에 있으므로
                                    RelativeSource로 부모 UserControl의 DataContext를 참조해야 함

                                    RelativeSource AncestorType=UserControl
                                    → "이 버튼을 포함하는 가장 가까운 UserControl을 찾아줘"
                                    → 그 DataContext = CategoryManagementViewModel
                                -->
                                <Button Width="28" Height="28" Margin="2" Cursor="Hand"
                                        Command="{Binding DataContext.SelectPresetColorCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding}" BorderThickness="0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 저장 버튼 -->
                    <Button Content="✔ 저장" Command="{Binding SaveCategoryCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,0,6"/>

                    <!-- 수정 버튼 (SelectedCategory 없으면 비활성화) -->
                    <Button Content="✎ 선택 항목 수정" Margin="0,0,0,6"
                            Command="{Binding StartEditCommand}"
                            Style="{StaticResource SecondaryButton}"/>

                    <!-- 삭제 버튼 (SelectedCategory 없으면 비활성화) -->
                    <Button Content="🗑 선택 항목 삭제" Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteCategoryCommand}" Margin="0,0,0,6"/>

                    <!-- 초기화 버튼 -->
                    <Button Content="✕ 초기화" Command="{Binding ClearFormCommand}"
                            Style="{StaticResource SecondaryButton}"/>
                    
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
