<Window x:Class="SubLog.View.CatalogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="구독 카탈로그"  WindowStartupLocation="CenterOwner"
        Width="500" Height="600" ResizeMode="NoResize" Background="#F4F6F9">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Search -->
            <RowDefinition Height="*"/>     <!-- Catalog List -->
            <RowDefinition Height="Auto"/>  <!-- Button -->
        </Grid.RowDefinitions>

        <!-- ━━━━━━━━━━━━━━━ Header ━━━━━━━━━━━━━━━ -->
        <Border Grid.Row="0" Padding="24,20,24,14" Background="White" BorderBrush="#E8ECF0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="📚 구독 카탈로그" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="서비스를 선택하면 정보가 자동으로 채워집니다" Margin="0,5,0,0" FontSize="12" Foreground="#7F8C8D"/>
            </StackPanel>
        </Border>

        <!-- ━━━━━━━━━━━━━━━ Search ━━━━━━━━━━━━━━━ -->
        <Border Grid.Row="1" Padding="16,10" Background="White" BorderBrush="#E8ECF0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderBrush="#DDE1E5"
                         VerticalContentAlignment="Center" Width="390" Height="32" Padding="8,0" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- ━━━━━━━━━━━━━━━ Catalog List ━━━━━━━━━━━━━━━ -->
        <ListBox Grid.Row="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="12,8"
                 ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" BorderThickness="0" Background="#F4F6F9">
            
            <!--
                ListBoxItem 스타일 재정의:
                기본 파란 선택 배경 대신 → 테두리+배경으로 카드 느낌 표현
            -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,3"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <!--
                                    x:Name="Bd": 트리거에서 이 Border를 찾아 스타일 적용
                                -->
                                <Border x:Name="Bd" Padding="14,11" Background="White" CornerRadius="10"
                                        BorderBrush="Transparent" BorderThickness="1.5">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- 선택됐을 때: 파란 테두리 + 연파랑 배경 -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#3498DB"/>
                                        <Setter TargetName="Bd" Property="Background"  Value="#EBF5FB"/>
                                    </Trigger>
                                    <!-- 마우스 올렸을 때: 연한 파란 테두리 -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#AED6F1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            
            <!-- 카탈로그 항목 카드 템플릿 -->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>   <!-- Emoji -->
                            <ColumnDefinition Width="*"/>    <!-- Name + Description -->
                            <ColumnDefinition Width="Auto"/> <!-- Price + Category -->
                        </Grid.ColumnDefinitions>
                        
                        <!-- Emoji Icon -->
                        <TextBlock Grid.Column="0" Text="{Binding Emoji}" FontSize="22" 
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        
                        <!-- Name + Description -->
                        <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                            
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            
                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#7F8C8D" Margin="0,2,0,0"/>
                            
                        </StackPanel>
                        
                        <!-- Price + Category Badge -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            
                            <TextBlock Text="{Binding PriceDisplay}" Foreground="#2C3E50"
                                       FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                            
                            <Border Background="#EBF5FB" HorizontalAlignment="Right" CornerRadius="4" Padding="6,2" Margin="0,4,0,0">
                                <TextBlock Text="{Binding CategoryName}" Foreground="#2980B9" FontSize="10"/>
                                
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ━━━━━━━━━━━━━━━ Button ━━━━━━━━━━━━━━━ -->
        <Border Grid.Row="3" Padding="16,12" Background="White" BorderBrush="#E8ECF0" BorderThickness="0,1,0,0">
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                
                <Button Content="취소" Command="{Binding CancelCommand}" Cursor="Hand"
                        Margin="0,0,10,0" Width="80" Height="38" FontSize="13"/>
                
                <Button Content="이 서비스로 추가 →" Command="{Binding SelectCommand}" Cursor="Hand"
                        Width="150" Height="38" Background="#3498DB" Foreground="White" FontSize="13" FontWeight="Bold"/>
                
            </StackPanel>
        </Border>
        
    </Grid>
</Window>
